generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo Usuario: Representa a los usuarios del sistema, incluyendo clientes y administradores de agencias.
// Sirve para gestionar la autenticación y autorización de usuarios en la plataforma.
// Relaciones: Tiene una relación uno a muchos con Pedido (un usuario puede tener múltiples pedidos).
model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol      @default(USUARIO)
  createdAt DateTime @default(now())
  pedidos   Pedido[]
}

// Modelo Agencia: Representa a las agencias fotográficas que ofrecen servicios de producción de cuadros escolares.
// Sirve para organizar y gestionar las agencias registradas en el sistema, incluyendo su configuración y productos.
// Relaciones: Tiene una relación uno a muchos con Paquete, Pedido, FechaDisponible y ModeloCuadro (una agencia puede tener múltiples paquetes, pedidos, fechas disponibles y modelos de cuadros).
model Agencia {
  id          String            @id @default(uuid())
  nombre      String
  slug        String            @unique
  descripcion String?
  logo        String?
  activa      Boolean           @default(false)
  suscripcion Boolean           @default(false)
  usuarioId   String?
  createdAt   DateTime          @default(now())
  paquetes    Paquete[]
  pedidos     Pedido[]
  fechas      FechaDisponible[]
  modelos     ModeloCuadro[]
}

// Modelo Paquete: Representa los paquetes de productos ofrecidos por las agencias, como diferentes tipos de cuadros escolares.
// Sirve para definir los productos disponibles para la venta, incluyendo nombre, descripción y precio.
// Relaciones: Pertenece a una Agencia (muchos a uno) y tiene una relación uno a muchos con Pedido (un paquete puede estar en múltiples pedidos).
model Paquete {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Float
  agenciaId   String
  agencia     Agencia  @relation(fields: [agenciaId], references: [id])
  pedidos     Pedido[]
}

// Modelo Pedido: Representa los pedidos realizados por los usuarios para adquirir productos de las agencias.
// Sirve para gestionar el proceso de compra, desde la solicitud hasta la entrega, incluyendo estado y pagos.
// Relaciones: Pertenece a un Usuario (muchos a uno), una Agencia (muchos a uno) y un Paquete (muchos a uno).
model Pedido {
  id             String       @id @default(uuid())
  usuarioId      String
  agenciaId      String
  paqueteId      String
  escuela        String
  grado          String
  leyenda        String
  estado         EstadoPedido @default(PENDIENTE)
  totalPago      Float
  anticipoPagado Boolean      @default(false)
  createdAt      DateTime     @default(now())
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  agencia        Agencia      @relation(fields: [agenciaId], references: [id])
  paquete        Paquete      @relation(fields: [paqueteId], references: [id])
}

// Modelo FechaDisponible: Representa las fechas disponibles para sesiones fotográficas o entregas por parte de las agencias.
// Sirve para gestionar la disponibilidad de horarios y cupos para servicios ofrecidos por las agencias.
// Relaciones: Pertenece a una Agencia (muchos a uno).
model FechaDisponible {
  id        String   @id @default(uuid())
  agenciaId String
  fecha     DateTime
  cupos     Int
  agencia   Agencia  @relation(fields: [agenciaId], references: [id])
}

// Modelo Publicidad: Representa los anuncios publicitarios de empresas externas en la plataforma.
// Sirve para gestionar la publicidad mostrada en el sistema, incluyendo imágenes y enlaces.
// Relaciones: No tiene relaciones directas con otras tablas; es independiente.
model Publicidad {
  id        String   @id @default(uuid())
  empresa   String
  imagen    String?
  link      String?
  activa    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Modelo ModeloCuadro: Representa los modelos o plantillas de cuadros disponibles para las agencias, como marcos, fondos y diseños.
// Sirve para definir los elementos visuales que las agencias pueden usar en sus productos.
// Relaciones: Pertenece a una Agencia (muchos a uno).
model ModeloCuadro {
  id          String   @id @default(uuid())
  agenciaId   String
  nombre      String
  tipo        TipoCuadro
  imagen      String
  createdAt   DateTime @default(now())
  agencia     Agencia  @relation(fields: [agenciaId], references: [id])
}

enum Rol {
  USUARIO
  AGENCIA
  ADMIN
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  EN_PRODUCCION
  LISTO
  ENTREGADO
}

enum TipoCuadro {
  MARCO
  FONDO
  DISENO
}